# Copy to backend/.env and fill in. Never commit the real file.

# MongoDB connection string
MONGO_URL="mongodb://localhost:27017"
DB_NAME="garment_foundry_dev"

# Comma-separated origins, or "*" for dev. Lock down to actual domains in prod.
CORS_ORIGINS="*"

# Public-facing frontend URL (used in transactional emails, redirects)
FRONTEND_URL="http://localhost:3000"

# Emergent platform LLM API key — get from Emergent dashboard
EMERGENT_LLM_KEY=""

APP_NAME="garment-foundry"

# Admin account seeded on first boot
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=""

# Email delivery (Resend is primary; SENDGRID kept for legacy fallback)
SENDGRID_API_KEY=""
SEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_API_KEY=""
