# Copy to frontend/.env and fill in. Never commit the real file.
# Note: REACT_APP_* values are baked into the public JS bundle — do not put secrets here.

# Backend API origin (no trailing slash)
REACT_APP_BACKEND_URL=http://localhost:8000

# Webpack dev-server websocket port for HMR behind HTTPS proxies
WDS_SOCKET_PORT=443

# Toggle backend /health check on app boot
ENABLE_HEALTH_CHECK=false
